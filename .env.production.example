PORT=3000
NODE_ENV=production
SESSION_SECRET=ubah_isi_ini_dengan_string_rahasia_yang_panjang_dan_aman
DATABASE_FILE=./data/database.sqlite

# Midtrans credentials
MIDTRANS_SERVER_KEY=YOUR_MIDTRANS_SERVER_KEY_HERE
MIDTRANS_CLIENT_KEY=YOUR_MIDTRANS_CLIENT_KEY_HERE
MIDTRANS_PRODUCTION=0

# Optional email config for reset password by email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass

# Optional admin identity override
ADMIN_EMAIL=admin@mieyamin.local
