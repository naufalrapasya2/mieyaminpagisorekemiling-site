<%- include('layout', { body: null }) %>

<section>
  <p>Bisa Pesan Antar: ShopeeFood • Pickup</p>
  <p class="muted">Deskripsi kecil: Harga disesuaikan dengan Ongkir pada ShopeeFood</p>
</section>

<section>
  <h2>Kategori</h2>
  <ul class="categories">
    <% categories.forEach(function(c){ %>
      <li><a href="/category/<%= c.id %>"><%= c.name %></a></li>
    <% }); %>
  </ul>
</section>

<section>
  <h2>Menu</h2>
  <div class="grid">
    <% items.forEach(function(it){ %>
      <div class="card">
        <img src="<%= it.image_url || '/images/placeholder.png' %>" alt="<%= it.name %>" />
        <h3><%= it.name %></h3>
        <p class="muted"><%= it.category_name %></p>
        <p><%= it.description %></p>
        <p class="price">Rp.<%= (it.price || 0).toLocaleString('id-ID') %></p>
        <div class="card-actions">
          <label>Qty: <input type="number" id="qty-<%= it.id %>" value="1" min="1" style="width:60px"></label>
          <button onclick="Cart.add({ id: <%= it.id %>, name: '<%= it.name.replace(/'/g,"\\'") %>', price: <%= it.price %>, qty: document.getElementById('qty-<%= it.id %>').value })">Tambah ke Keranjang</button>
        </div>
      </div>
    <% }); %>
  </div>
</section>

<section>
  <h3>Pesan lewat ShopeeFood</h3>
  <a class="btn" href="/order/shopee" target="_blank">Buka di ShopeeFood</a>
</section>
