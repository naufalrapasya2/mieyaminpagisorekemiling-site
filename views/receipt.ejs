<%- include('layout') %>

<section>
  <h2>Struk Pesanan</h2>
  <p><strong>Order ID:</strong> <%= orderId %></p>
  <p><strong>Nama:</strong> <%= customer_name %></p>
  <p><strong>Metode Pembayaran:</strong> <%= payment_method %></p>

  <h3>Rincian Pesanan</h3>
  <table class="table">
    <tr><th>Menu</th><th>Qty</th><th>Per item</th><th>Subtotal</th></tr>
    <% items.forEach(function(it){ %>
      <tr>
        <td><%= it.name %></td>
        <td><%= it.qty %></td>
        <td>Rp.<%= Number(it.price).toLocaleString('id-ID') %></td>
        <td>Rp.<%= (it.qty * it.price).toLocaleString('id-ID') %></td>
      </tr>
    <% }); %>
  </table>

  <p>Subtotal: Rp.<%= subtotal.toLocaleString('id-ID') %></p>
  <p>Ongkir: Rp.<%= ship.toLocaleString('id-ID') %></p>
  <p>Biaya Layanan: Rp.<%= fee.toLocaleString('id-ID') %></p>
  <h3>Total: Rp.<%= total.toLocaleString('id-ID') %></h3>

  <% if(redirect_url){ %>
    <p>Silakan lanjutkan pembayaran melalui Midtrans:</p>
    <p><a class="btn" href="<%= redirect_url %>" target="_blank">Lanjutkan Pembayaran</a></p>
  <% } else { %>
    <p>Metode pembayaran: <strong><%= payment_method %></strong></p>
  <% } %>

  <% if(notice){ %>
    <p class="error"><%= notice %></p>
  <% } %>

  <p>
    <a href="/receipt/<%= orderId %>/pdf" class="btn">Download PDF Struk</a>
    <a href="/" class="btn">Kembali ke beranda</a>
  </p>

  <p>Terima kasih telah memesan di MIE YAMIN PAGI SORE KEMILING.</p>
</section>
